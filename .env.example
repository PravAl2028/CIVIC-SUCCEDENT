# ── Firebase (Frontend - VITE_ prefixed for client-side) ──
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_APP_ID="1:xxxxx:web:xxxxx"
VITE_FIREBASE_API_KEY="your-firebase-api-key"

# ── API Keys (used by both frontend and backend) ──
VITE_GEOAPIFY_API_KEY="your-geoapify-api-key"
VITE_GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# ── Gemini Models (backend only) ──
GEMINI_SCANNER_MODEL="gemini-3.1-flash-lite"
GEMINI_DISPATCHER_MODEL="gemma-4-26b-a4b-it"
GEMINI_RESOLVER_MODEL="gemma-4-31b-it"

# ── Railway / Deployment ──
# PORT=3001

# ── Frontend API URL (for production - set to Railway backend URL) ──
# VITE_API_URL="https://your-app.up.railway.app"
